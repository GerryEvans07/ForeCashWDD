# Salin file ini menjadi .env.local, lalu isi nilainya.
# .env.local TIDAK ikut ke GitHub (sudah ada di .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat website (lokal: http://localhost:3000, online: alamat .vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend → API Keys (opsional, untuk email notifikasi)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ForeCash <onboarding@resend.dev>
